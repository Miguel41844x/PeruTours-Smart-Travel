rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }
    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    match /payment_vouchers/{userId}/{reservationId}/{fileName} {
      // HU07: el comprobante lo ve el cliente que lo envió y el agente
      // asignado a la reserva, verificado contra Firestore.
      allow read: if request.auth != null
                  && (
                    request.auth.uid == userId
                    || (
                      firestore.exists(
                        /databases/(default)/documents/reservations/$(reservationId)
                      )
                      && firestore.get(
                        /databases/(default)/documents/reservations/$(reservationId)
                      ).data.agentId == request.auth.uid
                    )
                  );
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && reservationId.size() > 0
                    && reservationId.size() <= 128
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)')
                    // La reserva debe existir, pertenecer al usuario que
                    // sube el comprobante y estar en un estado que admita
                    // (o readmite) el pago.
                    && firestore.exists(
                      /databases/(default)/documents/reservations/$(reservationId)
                    )
                    && firestore.get(
                      /databases/(default)/documents/reservations/$(reservationId)
                    ).data.clientId == request.auth.uid
                    && firestore.get(
                      /databases/(default)/documents/reservations/$(reservationId)
                    ).data.status in ['Confirmada', 'Pago rechazado'];
      allow update: if false;
      // El cliente solo puede descartar el archivo local mientras la
      // reserva siga Confirmada; una vez enviado queda bajo revisión.
      allow delete: if request.auth != null
                    && request.auth.uid == userId
                    && firestore.exists(
                      /databases/(default)/documents/reservations/$(reservationId)
                    )
                    && firestore.get(
                      /databases/(default)/documents/reservations/$(reservationId)
                    ).data.status == 'Confirmada';
    }
  }
}

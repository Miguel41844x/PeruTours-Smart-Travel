rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // users/{userId}
    //   Full profile: uid, name, email, phone, dni, city, role,
    //   photoUrl, preferences, updatedAt; optional fcmToken.
    //   A bootstrap document may contain only photoUrl and/or fcmToken.
    //   Profiles contain PII and are readable by their owner or an agent
    //   while preparing and managing a travel quotation.
    //
    // travel_requests/{requestId}
    //   id, userId, destination, destinationLatitude,
    //   destinationLongitude, originCity, originLatitude,
    //   originLongitude, departureAtMillis, returnAtMillis,
    //   travelerCount, notes, status, createdAtMillis;
    //   optional quotationId after an agent creates a quotation.
    //
    // catalog_services/{serviceId}
    //   id, name, city, category, unitCost, description,
    //   defaultQuantity, active.
    //
    // destinations/{destinationId}   (HU catálogo turístico)
    //   id, name, department, summary, latitude, longitude,
    //   coverImageUrl, categories, externalPlaceId, status,
    //   createdBy, createdAtMillis, updatedAtMillis.
    //   status: BORRADOR | PUBLICADO | ARCHIVADO. Solo el administrador
    //   escribe; el cliente únicamente puede leer destinos PUBLICADOS.
    //   latitude/longitude provienen de la geocodificación externa y
    //   alimentan la consulta de puntos de interés cercanos.
    //
    // providers/{providerId}          (HU catálogo turístico)
    //   id, name, contactName, phone, email, city, serviceNames,
    //   active, createdBy, createdAtMillis, updatedAtMillis.
    //
    // packages/{packageId}            (HU catálogo turístico)
    //   id, destinationId, title, summary, durationText, durationDays,
    //   priceAmount, currency, ratingScore, category, coverImageUrl,
    //   conditions, includedServiceIds, status, createdBy,
    //   createdAtMillis, updatedAtMillis.
    //   status: BORRADOR | PUBLICADO | ARCHIVADO. El cliente solo ve
    //   los paquetes PUBLICADOS.
    //
    // packages/{packageId}/included_services/{serviceId}
    //   serviceId (ID del servicio incluido, documento = ID de servicio).
    //
    // preferences/{preferenceId}
    //   id, name, description, active, order.
    //
    // cotizaciones/{quotationId}
    //   id, requestId, clientId, clientName, clientEmail, destination,
    //   travelerCount, services, baseCost, marginPercent, totalAmount,
    //   currency, validityDate, validUntilMillis, conditions, status,
    //   agentId, agentName,
    //   clientFcmToken, createdAtMillis, respondedAtMillis,
    //   latestObservation, reservationId.
    //   HU07 payment fields are intentionally not stored on quotations.
    //
    // cotizaciones/{quotationId}/observations/{observationId}
    //   id, quotationId, authorId, authorName, message,
    //   resultingStatus, createdAtMillis.
    //
    // reservations/{reservationId}
    //   id, quotationId, requestId, clientId, agentId, destination,
    //   originCity, departureAtMillis, returnAtMillis, travelerCount,
    //   services, totalAmount, currency, validityDate, conditions,
    //   status, createdAtMillis, paymentId, paymentVoucherUrl,
    //   paymentMethod, paidAtMillis. A new reservation starts Confirmada
    //   with empty payment fields. HU07 flow: Confirmada → Pago enviado
    //   → Pagado | Pago rechazado. paymentId points to the payment doc
    //   once a voucher has been submitted. HU06 uses the quotation ID
    //   as the reservation document ID.
    //
    // payments/{paymentId}
    //   id, reservationId, quotationId, clientId, agentId, method,
    //   amount, currency, voucherUrl, status, rejectionReason,
    //   submittedAtMillis, reviewedAtMillis, reviewedBy.
    //   paymentId equals the reservation ID so a reservation can never
    //   have two payment documents. The client submits with status
    //   'Pendiente'; only the assigned agent may move it to 'Aprobado'
    //   or 'Rechazado' with a mandatory reason.
    //
    // trip_itinerary_items/{itemId}
    //   id, reservationId, clientId, agentId, title, description,
    //   category, locationName, latitude, longitude, startAtMillis,
    //   endAtMillis, dayIndex, sortOrder, providerName, status, notes,
    //   source, createdAtMillis, updatedAtMillis. Only the agent assigned
    //   to a paid reservation manages the confirmed itinerary.
    //
    // trip_checklist_items/{itemId}
    //   id, reservationId, clientId, title, category, isCompleted,
    //   createdAtMillis, updatedAtMillis. Private preparation list owned
    //   by the client of a paid reservation.
    //
    // trip_incidents/{incidentId}
    //   id, reservationId, clientId, agentId, category, priority,
    //   status, description, locationName, latitude, longitude,
    //   agentResponse, createdAtMillis, updatedAtMillis,
    //   resolvedAtMillis. The client creates it; only the assigned agent
    //   may add a response and move it to En revisión or Resuelta.
    //
    // fcm_push_logs/{logId}
    //   toToken, title, body, quotationId, status, timestamp.
    //
    // All time values currently produced by the Android app are epoch
    // milliseconds (integer), not Firestore Timestamp values.
    // ===============================================================

    // ===============================================================
    // Authentication and authorization helpers
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasUserProfile(userId) {
      return exists(userPath(userId));
    }

    function hasRole(role) {
      return isAuthenticated()
        && hasUserProfile(request.auth.uid)
        && get(userPath(request.auth.uid)).data.role == role;
    }

    function isClient() {
      return hasRole('cliente');
    }

    function isAgent() {
      return hasRole('agente');
    }

    function isManager() {
      return (isAuthenticated() && request.auth.token.email == 'adminperutours@gmail.com')
        || hasRole('gerente')
        || hasRole('administrador');
    }

    // HU catálogo turístico: la gestión de destinos, proveedores y
    // paquetes está reservada al administrador del caso de negocio.
    function isAdmin() {
      return (isAuthenticated() && request.auth.token.email == 'adminperutours@gmail.com')
        || hasRole('administrador');
    }

    // Verify UID has not been tampered with on create.
    function uidUnchanged() {
      return isAuthenticated()
        && (!('uid' in request.resource.data)
          || request.resource.data.uid == request.auth.uid);
    }

    // Ensure an existing UID field is not modified on update.
    function uidNotModified() {
      return !('uid' in resource.data)
        || (('uid' in request.resource.data)
          && request.resource.data.uid == resource.data.uid);
    }

    // ===============================================================
    // Generic validation helpers
    // ===============================================================

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(fields);
    }

    function validString(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function validOptionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function isValidEmail(value) {
      return value is string
        && value.size() <= 254
        && value.matches('^[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}$');
    }

    function isValidUrl(value) {
      return value is string
        && value.size() <= 2048
        && (value == '' || value.matches('^https://.*'));
    }

    function isRecentMillis(value) {
      return value is int
        && value >= request.time.toMillis() - 300000
        && value <= request.time.toMillis() + 300000;
    }

    function isPositiveBoundedNumber(value, maximum) {
      return value is number && value >= 0 && value <= maximum;
    }

    function isValidListStringItem(values, index, maxLength) {
      return values.size() <= index
        || (values[index] is string
          && values[index].size() > 0
          && values[index].size() <= maxLength);
    }

    // Firestore Rules has no general-purpose loop, so the profile list is
    // capped and each possible element is checked explicitly. A newly
    // registered client may still have no preferences selected.
    function isValidPreferenceIdList(values) {
      return values is list
        && values.size() <= 10
        && isValidListStringItem(values, 0, 100)
        && isValidListStringItem(values, 1, 100)
        && isValidListStringItem(values, 2, 100)
        && isValidListStringItem(values, 3, 100)
        && isValidListStringItem(values, 4, 100)
        && isValidListStringItem(values, 5, 100)
        && isValidListStringItem(values, 6, 100)
        && isValidListStringItem(values, 7, 100)
        && isValidListStringItem(values, 8, 100)
        && isValidListStringItem(values, 9, 100);
    }

    // ===============================================================
    // Domain validators
    // ===============================================================

    function isValidBootstrapUser(data) {
      return hasOnlyAllowedFields(data, ['photoUrl', 'fcmToken', 'updatedAt'])
        && data.keys().hasAny(['photoUrl', 'fcmToken', 'updatedAt'])
        && validOptionalString(data, 'fcmToken', 4096)
        && (!('photoUrl' in data) || isValidUrl(data.photoUrl))
        && (!('updatedAt' in data) || (data.updatedAt is int && data.updatedAt > 0));
    }

    function isValidFullUser(data) {
      return hasRequiredFields(data, [
          'uid', 'name', 'email', 'phone', 'dni', 'city', 'role',
          'photoUrl', 'preferences', 'updatedAt'
        ])
        && hasOnlyAllowedFields(data, [
          'uid', 'name', 'email', 'phone', 'dni', 'city', 'role',
          'photoUrl', 'preferences', 'updatedAt', 'fcmToken'
        ])
        && validString(data.uid, 1, 128)
        && validString(data.name, 3, 100)
        && isValidEmail(data.email)
        && data.email == request.auth.token.email
        && data.phone is string
        && data.phone.matches('^9[0-9]{8}$')
        && data.dni is string
        && data.dni.size() <= 12
        && (data.dni == ''
          || data.dni.matches('^[0-9]{8}$')
          || (data.dni.size() >= 6 && data.dni.matches('^[A-Za-z0-9]+$')))
        && validString(data.city, 2, 100)
        && data.role in ['cliente', 'agente', 'gerente', 'administrador']
        && isValidUrl(data.photoUrl)
        && isValidPreferenceIdList(data.preferences)
        && data.updatedAt is int
        && data.updatedAt > 0
        && validOptionalString(data, 'fcmToken', 4096);
    }

    function isValidUser(data) {
      return isValidBootstrapUser(data) || isValidFullUser(data);
    }

    function isValidUserCreate(userId) {
      return isOwner(userId)
        && uidUnchanged()
        && isValidUser(request.resource.data)
        && (isValidBootstrapUser(request.resource.data)
          || (request.resource.data.uid == userId
            && request.resource.data.role == 'cliente'
            && isRecentMillis(request.resource.data.updatedAt)));
    }

    function isValidUserUpdate(userId) {
      return isOwner(userId)
        && uidNotModified()
        && isValidUser(request.resource.data)
        && (
          // Once a complete profile exists, it may never be downgraded to a
          // bootstrap document and its role remains immutable.
          (('role' in resource.data)
            && isValidFullUser(request.resource.data)
            && request.resource.data.uid == userId
            && request.resource.data.role == resource.data.role)
          ||
          // A bootstrap profile can become a complete client profile, never
          // an agent profile, or remain a restricted bootstrap profile.
          (!('role' in resource.data)
            && (isValidBootstrapUser(request.resource.data)
              || (isValidFullUser(request.resource.data)
                && request.resource.data.uid == userId
                && request.resource.data.role == 'cliente')))
        )
        && (!request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['updatedAt'])
          || isRecentMillis(request.resource.data.updatedAt));
    }

    function isValidCoordinates(data) {
      return (
          data.originLatitude == null
          && data.originLongitude == null
        ) || (
          data.originLatitude is number
          && data.originLatitude >= -90
          && data.originLatitude <= 90
          && data.originLongitude is number
          && data.originLongitude >= -180
          && data.originLongitude <= 180
        );
    }

    function isValidDestinationCoordinates(data) {
      return (
          !('destinationLatitude' in data)
          && !('destinationLongitude' in data)
        ) || (
          data.destinationLatitude is number
          && data.destinationLatitude >= -90
          && data.destinationLatitude <= 90
          && data.destinationLongitude is number
          && data.destinationLongitude >= -180
          && data.destinationLongitude <= 180
        );
    }

    function isValidTravelRequest(data) {
      return hasRequiredFields(data, [
          'id', 'userId', 'destination', 'originCity',
          'originLatitude', 'originLongitude', 'departureAtMillis',
          'returnAtMillis', 'travelerCount', 'notes', 'status',
          'createdAtMillis'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'userId', 'destination', 'destinationLatitude',
          'destinationLongitude', 'originCity',
          'originLatitude', 'originLongitude', 'departureAtMillis',
          'returnAtMillis', 'travelerCount', 'notes', 'status',
          'createdAtMillis', 'quotationId'
        ])
        && validString(data.id, 1, 128)
        && validString(data.userId, 1, 128)
        && validString(data.destination, 3, 120)
        && validString(data.originCity, 2, 120)
        && isValidDestinationCoordinates(data)
        && isValidCoordinates(data)
        && data.departureAtMillis is int
        && data.returnAtMillis is int
        && data.departureAtMillis > data.createdAtMillis
        && data.returnAtMillis > data.departureAtMillis
        && data.travelerCount is int
        && data.travelerCount >= 1
        && data.travelerCount <= 20
        && data.notes is string
        && data.notes.size() <= 500
        && data.status in [
          'Pendiente de cotizacion', 'Cotizado', 'Aceptada',
          'Observada', 'Cancelada'
        ]
        && data.createdAtMillis is int
        && data.createdAtMillis > 0
        && validOptionalString(data, 'quotationId', 128);
    }

    function isValidCatalogService(data) {
      return hasRequiredFields(data, [
          'id', 'name', 'city', 'category', 'unitCost',
          'description', 'defaultQuantity', 'active'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'name', 'city', 'category', 'unitCost',
          'commercialCost', 'supplierName',
          'description', 'defaultQuantity', 'active'
        ])
        && validString(data.id, 1, 128)
        && validString(data.name, 1, 120)
        && validString(data.city, 1, 100)
        && validString(data.category, 1, 80)
        && isPositiveBoundedNumber(data.unitCost, 1000000)
        && isPositiveBoundedNumber(data.commercialCost, 1000000)
        && data.supplierName is string
        && data.supplierName.size() <= 120
        && data.description is string
        && data.description.size() <= 1000
        && data.defaultQuantity is int
        && data.defaultQuantity >= 1
        && data.defaultQuantity <= 100
        && data.active is bool;
    }

    // ===============================================================
    // HU catálogo turístico: destinos, proveedores y paquetes
    // ===============================================================

    // Firestore Rules no permite bucles generales: la lista de categorías
    // se inspecciona posición por posición hasta un máximo de 10, siguiendo
    // el mismo patrón (y el mismo límite de presupuesto) que preferences.
    function isValidCategoryItem(values, index) {
      return values.size() <= index
        || (values[index] is string
          && values[index].size() > 0
          && values[index].size() <= 60);
    }

    function isValidCategoryList(values) {
      return values is list
        && values.size() <= 10
        && isValidCategoryItem(values, 0)
        && isValidCategoryItem(values, 1)
        && isValidCategoryItem(values, 2)
        && isValidCategoryItem(values, 3)
        && isValidCategoryItem(values, 4)
        && isValidCategoryItem(values, 5)
        && isValidCategoryItem(values, 6)
        && isValidCategoryItem(values, 7)
        && isValidCategoryItem(values, 8)
        && isValidCategoryItem(values, 9);
    }

    function isValidIncludedServiceIdItem(values, index) {
      return values.size() <= index
        || (values[index] is string
          && values[index].size() > 0
          && values[index].size() <= 128);
    }

    function isValidIncludedServiceIdList(values) {
      return values is list
        && values.size() <= 10
        && isValidIncludedServiceIdItem(values, 0)
        && isValidIncludedServiceIdItem(values, 1)
        && isValidIncludedServiceIdItem(values, 2)
        && isValidIncludedServiceIdItem(values, 3)
        && isValidIncludedServiceIdItem(values, 4)
        && isValidIncludedServiceIdItem(values, 5)
        && isValidIncludedServiceIdItem(values, 6)
        && isValidIncludedServiceIdItem(values, 7)
        && isValidIncludedServiceIdItem(values, 8)
        && isValidIncludedServiceIdItem(values, 9);
    }

    function isValidProviderServiceItem(values, index) {
      return values.size() <= index
        || (values[index] is string
          && values[index].size() > 0
          && values[index].size() <= 120);
    }

    function isValidProviderServiceList(values) {
      return values is list
        && values.size() <= 10
        && isValidProviderServiceItem(values, 0)
        && isValidProviderServiceItem(values, 1)
        && isValidProviderServiceItem(values, 2)
        && isValidProviderServiceItem(values, 3)
        && isValidProviderServiceItem(values, 4)
        && isValidProviderServiceItem(values, 5)
        && isValidProviderServiceItem(values, 6)
        && isValidProviderServiceItem(values, 7)
        && isValidProviderServiceItem(values, 8)
        && isValidProviderServiceItem(values, 9);
    }

    function isValidCatalogStatus(value) {
      return value in ['BORRADOR', 'PUBLICADO', 'ARCHIVADO'];
    }

    function isValidPublishedDestination(data) {
      return data.status != 'PUBLICADO' || (
        (data.latitude != 0 || data.longitude != 0)
        && validString(data.externalPlaceId, 1, 128)
      );
    }

    function isValidCatalogTimestamps(data) {
      return data.createdAtMillis is int
        && data.createdAtMillis > 0
        && data.updatedAtMillis is int
        && data.updatedAtMillis > 0
        && data.updatedAtMillis >= data.createdAtMillis;
    }

    function isValidDestination(data) {
      return hasRequiredFields(data, [
          'id', 'name', 'department', 'summary', 'latitude', 'longitude',
          'coverImageUrl', 'categories', 'externalPlaceId', 'status',
          'createdBy', 'createdAtMillis', 'updatedAtMillis'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'name', 'department', 'summary', 'latitude', 'longitude',
          'coverImageUrl', 'categories', 'externalPlaceId', 'status',
          'createdBy', 'createdAtMillis', 'updatedAtMillis'
        ])
        && validString(data.id, 1, 128)
        && validString(data.name, 3, 120)
        && validString(data.department, 2, 100)
        && data.summary is string
        && data.summary.size() <= 1000
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && isValidUrl(data.coverImageUrl)
        && isValidCategoryList(data.categories)
        && data.externalPlaceId is string
        && data.externalPlaceId.size() <= 128
        && isValidCatalogStatus(data.status)
        && isValidPublishedDestination(data)
        && validString(data.createdBy, 1, 128)
        && isValidCatalogTimestamps(data);
    }

    function isValidProvider(data) {
      return hasRequiredFields(data, [
          'id', 'name', 'contactName', 'phone', 'email', 'city',
          'serviceNames', 'active', 'createdBy', 'createdAtMillis',
          'updatedAtMillis'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'name', 'contactName', 'phone', 'email', 'city',
          'serviceNames', 'active', 'createdBy', 'createdAtMillis',
          'updatedAtMillis'
        ])
        && validString(data.id, 1, 128)
        && validString(data.name, 2, 120)
        && data.contactName is string
        && data.contactName.size() <= 120
        && data.phone is string
        && data.phone.size() <= 20
        && isValidEmail(data.email)
        && validString(data.city, 2, 100)
        && isValidProviderServiceList(data.serviceNames)
        && data.active is bool
        && validString(data.createdBy, 1, 128)
        && isValidCatalogTimestamps(data);
    }

    function isValidPackage(data) {
      return hasRequiredFields(data, [
          'id', 'destinationId', 'title', 'summary', 'durationText',
          'durationDays', 'priceAmount', 'currency', 'ratingScore',
          'category', 'coverImageUrl', 'conditions', 'includedServiceIds',
          'status', 'createdBy', 'createdAtMillis', 'updatedAtMillis'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'destinationId', 'title', 'summary', 'durationText',
          'durationDays', 'priceAmount', 'currency', 'ratingScore',
          'category', 'coverImageUrl', 'conditions', 'includedServiceIds',
          'status', 'createdBy', 'createdAtMillis', 'updatedAtMillis'
        ])
        && validString(data.id, 1, 128)
        && validString(data.destinationId, 1, 128)
        && validString(data.title, 3, 140)
        && data.summary is string
        && data.summary.size() <= 1000
        && data.durationText is string
        && data.durationText.size() <= 60
        && data.durationDays is int
        && data.durationDays >= 1
        && data.durationDays <= 365
        && isPositiveBoundedNumber(data.priceAmount, 100000000)
        && data.currency in ['PEN', 'USD']
        && isPositiveBoundedNumber(data.ratingScore, 5)
        && validString(data.category, 1, 80)
        && isValidUrl(data.coverImageUrl)
        && data.conditions is string
        && data.conditions.size() <= 2000
        && isValidIncludedServiceIdList(data.includedServiceIds)
        && isValidCatalogStatus(data.status)
        && validString(data.createdBy, 1, 128)
        && isValidCatalogTimestamps(data);
    }

    // Un destino puede archivarse, pero su ID, autoría y fecha de creación
    // quedan congelados en cualquier actualización del catálogo.
    function catalogIdentityPinned(collection) {
      let data = request.resource.data;
      let previous = resource.data;
      return data.id == previous.id
        && data.createdBy == previous.createdBy
        && data.createdAtMillis == previous.createdAtMillis
        && request.resource.data.id == collection;
    }

    function isValidPreference(data) {
      return hasRequiredFields(data, [
          'id', 'name', 'description', 'active', 'order'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'name', 'description', 'active', 'order'
        ])
        && validString(data.id, 1, 128)
        && validString(data.name, 1, 100)
        && data.description is string
        && data.description.size() <= 500
        && data.active is bool
        && data.order is int
        && data.order >= 0
        && data.order <= 10000;
    }

    function isValidQuotationServiceItem(item) {
      return item is map
        // Keep this validator flat: it is evaluated once per service and
        // nested helper calls quickly consume Firestore's expression budget.
        && item.keys().hasOnly([
          'id', 'name', 'category', 'unitCost', 'quantity', 'subtotal',
          'commercialCost', 'supplierName'
        ])
        // matches() also rejects non-string values while enforcing bounds.
        && item.id.matches('^.{1,128}$')
        && item.name.matches('^.{1,120}$')
        && item.category.matches('^.{1,80}$')
        && item.unitCost is number
        && item.unitCost >= 0
        && item.unitCost <= 1000000
        && item.quantity is int
        && item.quantity >= 1
        && item.quantity <= 100
        // The equality below enforces a numeric subtotal; its bounds follow
        // from bounded unitCost and quantity.
        && math.abs(item.subtotal - item.unitCost * item.quantity) < 0.01
        && item.commercialCost is number
        && item.commercialCost >= 0
        && item.commercialCost <= 1000000
        && item.supplierName.matches('^.{0,100}$');
    }

    // As with preferences, every allowed list position is inspected.
    // NOTE: the rules evaluator allows at most 1000 expressions per request,
    // and it charges every function call it reaches. Scanning 20 positions
    // of this expensive per-item check made every quotation write exceed the
    // budget and fail with PERMISSION_DENIED, so the app caps quotations at
    // 5 services (QuotationValidator.MAX_SERVICES) and the rules mirror
    // that limit with exactly 5 inspected positions.
    function isValidQuotationServices(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 5
        && isValidQuotationServiceItem(items[0])
        && (items.size() < 2 || isValidQuotationServiceItem(items[1]))
        && (items.size() < 3 || isValidQuotationServiceItem(items[2]))
        && (items.size() < 4 || isValidQuotationServiceItem(items[3]))
        && (items.size() < 5 || isValidQuotationServiceItem(items[4]));
    }

    function isValidQuotation(data) {
      // Every required field is accessed and type checked below; a missing
      // field therefore rejects the write without a second large key list.
      return data.keys().hasOnly([
          'id', 'requestId', 'clientId', 'clientName', 'clientEmail',
          'destination', 'travelerCount', 'services', 'baseCost',
          'marginPercent', 'totalAmount', 'currency', 'validityDate',
          'validUntilMillis', 'conditions', 'status', 'agentId', 'agentName',
          'createdAtMillis', 'respondedAtMillis',
          'latestObservation', 'reservationId',
          'version', 'parentQuotationId'
        ])
        && data.id.matches('^.{1,128}$')
        && data.requestId.matches('^.{1,128}$')
        && data.clientId.matches('^.{1,128}$')
        && data.clientName.matches('^.{1,100}$')
        && data.clientEmail is string
        && data.clientEmail.size() <= 254
        && data.clientEmail.matches('^[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}$')
        && data.destination.matches('^.{3,120}$')
        && data.travelerCount is int
        && data.travelerCount >= 1
        && data.travelerCount <= 20
        && isValidQuotationServices(data.services)
        && data.baseCost is number
        && data.baseCost >= 0
        && data.baseCost <= 100000000
        && data.marginPercent is int
        && data.marginPercent >= 0
        && data.marginPercent <= 100
        && data.totalAmount is number
        && data.totalAmount >= 0
        && data.totalAmount <= 200000000
        && data.totalAmount >= data.baseCost
        && data.currency in ['USD', 'PEN']
        && data.validityDate is string
        && data.validityDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.validUntilMillis is int
        && data.validUntilMillis > request.time.toMillis()
        && data.validUntilMillis <= request.time.toMillis() + 2678400000
        && data.conditions is string
        && data.conditions.size() <= 2000
        && data.status == 'Cotizado'
        && data.agentId.matches('^.{1,128}$')
        && data.agentName.matches('^.{1,100}$')
        && data.createdAtMillis is int
        && data.createdAtMillis >= request.time.toMillis() - 300000
        && data.createdAtMillis <= request.time.toMillis() + 300000
        && data.respondedAtMillis == null
        && data.latestObservation == ''
        && data.reservationId == ''
        && data.version is int
        && data.version == 1
        && data.parentQuotationId == '';
    }

    // Validates only the fields that may change on update. Identity fields
    // (id, clientId, agentId, createdAtMillis, ...) are pinned by the
    // affectedKeys().hasOnly(...) checks in the update rules, so re-running
    // the full isValidQuotation here would only waste the evaluator's
    // expression budget (1000 per write) — which previously made every
    // quotation save fail with PERMISSION_DENIED.
    function isValidQuotationUpdateFields(data) {
      return isValidQuotationServices(data.services)
        && isPositiveBoundedNumber(data.baseCost, 100000000)
        && data.marginPercent is int
        && data.marginPercent >= 0
        && data.marginPercent <= 100
        && isPositiveBoundedNumber(data.totalAmount, 200000000)
        && data.totalAmount >= data.baseCost
        && data.currency in ['USD', 'PEN']
        && data.validityDate is string
        && data.validityDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.validUntilMillis is int
        && data.validUntilMillis > request.time.toMillis()
        && data.validUntilMillis <= request.time.toMillis() + 2678400000
        && data.conditions is string
        && data.conditions.size() <= 2000
        && data.status in ['Cotizado', 'Aceptada', 'Observada', 'Cancelada']
        && data.version is int
        && data.version >= 1
        && data.parentQuotationId is string
        && data.parentQuotationId.size() <= 128
        && data.latestObservation is string
        && data.latestObservation.size() <= 500
        && data.reservationId is string
        && data.reservationId.size() <= 128
        && (data.respondedAtMillis == null
          || (data.respondedAtMillis is int && data.respondedAtMillis > 0));
    }

    function isValidObservation(data) {
      return hasRequiredFields(data, [
          'id', 'quotationId', 'authorId', 'authorName', 'message',
          'resultingStatus', 'createdAtMillis'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'quotationId', 'authorId', 'authorName', 'message',
          'resultingStatus', 'createdAtMillis'
        ])
        && validString(data.id, 1, 128)
        && validString(data.quotationId, 1, 128)
        && validString(data.authorId, 1, 128)
        && validString(data.authorName, 1, 100)
        && validString(data.message, 10, 500)
        && data.resultingStatus == 'Observada'
        && isRecentMillis(data.createdAtMillis);
    }

    // Used only by the reservation create rule. The rule cross-checks
    // every business value against the quotation/request documents via
    // getAfter (see isValidAcceptedReservation) and asserts the status /
    // payment invariants inline — and every required field is read by one
    // of those checks, so a missing field already fails the rule with an
    // evaluation error. Only the "no extra fields" guarantee is needed
    // here; re-validating each field blew the evaluator's shared
    // 1000-expression budget for the whole accept batch.
    function isValidReservation(data) {
      return hasOnlyAllowedFields(data, [
          'id', 'quotationId', 'requestId', 'clientId', 'agentId',
          'destination', 'originCity', 'departureAtMillis',
          'returnAtMillis', 'travelerCount', 'services', 'totalAmount',
          'currency', 'validityDate', 'conditions', 'status', 'createdAtMillis',
          'paymentId', 'paymentVoucherUrl', 'paymentMethod', 'paidAtMillis'
        ]);
    }

    function isValidPayment(data) {
      return hasRequiredFields(data, [
          'id', 'reservationId', 'quotationId', 'clientId', 'agentId',
          'method', 'amount', 'currency', 'voucherUrl', 'status',
          'rejectionReason', 'submittedAtMillis', 'reviewedAtMillis',
          'reviewedBy'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'reservationId', 'quotationId', 'clientId', 'agentId',
          'method', 'amount', 'currency', 'voucherUrl', 'status',
          'rejectionReason', 'submittedAtMillis', 'reviewedAtMillis',
          'reviewedBy'
        ])
        && validString(data.id, 1, 128)
        && validString(data.reservationId, 1, 128)
        && validString(data.quotationId, 1, 128)
        && validString(data.clientId, 1, 128)
        && validString(data.agentId, 1, 128)
        && data.method in ['Yape', 'Plin', 'Transferencia BCP']
        && isPositiveBoundedNumber(data.amount, 200000000)
        && data.currency in ['USD', 'PEN']
        && data.voucherUrl is string
        && data.voucherUrl.size() <= 2048
        && data.voucherUrl.matches('^https://.+')
        && data.status in ['Pendiente', 'Aprobado', 'Rechazado']
        && data.rejectionReason is string
        && data.rejectionReason.size() <= 500
        && data.submittedAtMillis is int
        && data.submittedAtMillis > 0
        && (data.reviewedAtMillis == null
          || (data.reviewedAtMillis is int && data.reviewedAtMillis > 0))
        && data.reviewedBy is string
        && data.reviewedBy.size() <= 128
        && (
          (data.status == 'Pendiente'
            && data.rejectionReason == ''
            && data.reviewedAtMillis == null
            && data.reviewedBy == '')
          ||
          (data.status == 'Aprobado'
            && data.rejectionReason == ''
            && data.reviewedAtMillis is int
            && data.reviewedBy == request.auth.uid)
          ||
          (data.status == 'Rechazado'
            && validString(data.rejectionReason, 10, 500)
            && data.reviewedAtMillis is int
            && data.reviewedBy == request.auth.uid)
        );
    }

    function isValidStoredMillis(value) {
      return value is int
        && value > 0
        && value <= request.time.toMillis() + 300000;
    }

    function isValidTripCoordinates(latitude, longitude) {
      return latitude is number
        && longitude is number
        && latitude >= -90
        && latitude <= 90
        && longitude >= -180
        && longitude <= 180;
    }

    function isValidTripItineraryItem(data) {
      return hasRequiredFields(data, [
          'id', 'reservationId', 'clientId', 'agentId', 'title',
          'description', 'category', 'locationName', 'latitude',
          'longitude', 'startAtMillis', 'endAtMillis', 'dayIndex',
          'sortOrder', 'providerName', 'status', 'notes', 'source',
          'createdAtMillis', 'updatedAtMillis'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'reservationId', 'clientId', 'agentId', 'title',
          'description', 'category', 'locationName', 'latitude',
          'longitude', 'startAtMillis', 'endAtMillis', 'dayIndex',
          'sortOrder', 'providerName', 'status', 'notes', 'source',
          'createdAtMillis', 'updatedAtMillis'
        ])
        && validString(data.id, 1, 128)
        && validString(data.reservationId, 1, 128)
        && validString(data.clientId, 1, 128)
        && validString(data.agentId, 1, 128)
        && validString(data.title, 3, 120)
        && data.description is string
        && data.description.size() <= 1500
        && data.category in [
          'Actividad', 'Transporte', 'Alojamiento', 'Alimentación', 'Otro'
        ]
        && data.locationName is string
        && data.locationName.size() <= 160
        && isValidTripCoordinates(data.latitude, data.longitude)
        && data.startAtMillis is int
        && data.startAtMillis > 0
        && data.endAtMillis is int
        && data.endAtMillis >= data.startAtMillis
        && data.dayIndex is int
        && data.dayIndex >= 1
        && data.dayIndex <= 365
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.providerName is string
        && data.providerName.size() <= 120
        && data.status in ['Programado', 'Completado', 'Cancelado']
        && data.notes is string
        && data.notes.size() <= 500
        && data.source == 'agent'
        && isValidStoredMillis(data.createdAtMillis)
        && isValidStoredMillis(data.updatedAtMillis)
        && data.updatedAtMillis >= data.createdAtMillis;
    }

    function isValidTripChecklistItem(data) {
      return hasRequiredFields(data, [
          'id', 'reservationId', 'clientId', 'title', 'category',
          'isCompleted', 'createdAtMillis', 'updatedAtMillis'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'reservationId', 'clientId', 'title', 'category',
          'isCompleted', 'createdAtMillis', 'updatedAtMillis'
        ])
        && validString(data.id, 1, 128)
        && validString(data.reservationId, 1, 128)
        && validString(data.clientId, 1, 128)
        && validString(data.title, 1, 100)
        && data.category in ['Equipaje', 'Documentos', 'Salud', 'Dinero', 'Otros']
        && data.isCompleted is bool
        && isValidStoredMillis(data.createdAtMillis)
        && isValidStoredMillis(data.updatedAtMillis)
        && data.updatedAtMillis >= data.createdAtMillis;
    }

    function isValidTripIncident(data) {
      return hasRequiredFields(data, [
          'id', 'reservationId', 'clientId', 'agentId', 'category',
          'priority', 'status', 'description', 'locationName',
          'latitude', 'longitude', 'agentResponse', 'createdAtMillis',
          'updatedAtMillis', 'resolvedAtMillis'
        ])
        && hasOnlyAllowedFields(data, [
          'id', 'reservationId', 'clientId', 'agentId', 'category',
          'priority', 'status', 'description', 'locationName',
          'latitude', 'longitude', 'agentResponse', 'createdAtMillis',
          'updatedAtMillis', 'resolvedAtMillis'
        ])
        && validString(data.id, 1, 128)
        && validString(data.reservationId, 1, 128)
        && validString(data.clientId, 1, 128)
        && validString(data.agentId, 1, 128)
        && data.category in ['Transporte', 'Alojamiento', 'Actividad', 'Salud', 'Otro']
        && data.priority in ['Baja', 'Media', 'Alta', 'Urgente']
        && data.status in ['Abierta', 'En revisión', 'Resuelta', 'Cerrada']
        && validString(data.description, 10, 1000)
        && data.locationName is string
        && data.locationName.size() <= 160
        && isValidTripCoordinates(data.latitude, data.longitude)
        && data.agentResponse is string
        && data.agentResponse.size() <= 1000
        && isValidStoredMillis(data.createdAtMillis)
        && isValidStoredMillis(data.updatedAtMillis)
        && data.updatedAtMillis >= data.createdAtMillis
        && (data.resolvedAtMillis == null
          || isValidStoredMillis(data.resolvedAtMillis));
    }

    // ===============================================================
    // Relationship and transition helpers
    // ===============================================================

    function requestPath(requestId) {
      return /databases/$(database)/documents/travel_requests/$(requestId);
    }

    function quotationPath(quotationId) {
      return /databases/$(database)/documents/cotizaciones/$(quotationId);
    }

    function reservationPath(reservationId) {
      return /databases/$(database)/documents/reservations/$(reservationId);
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId);
    }

    function paidReservationBelongsToClient(reservationId, clientId) {
      return exists(reservationPath(reservationId))
        && get(reservationPath(reservationId)).data.clientId == clientId
        && get(reservationPath(reservationId)).data.status == 'Pagado';
    }

    function paidReservationAssignedToAgent(reservationId, agentId) {
      return exists(reservationPath(reservationId))
        && get(reservationPath(reservationId)).data.agentId == agentId
        && get(reservationPath(reservationId)).data.status == 'Pagado';
    }

    function isValidAgentQuotationCreate(quotationId) {
      let data = request.resource.data;
      let requestAfter = getAfter(requestPath(data.requestId)).data;
      let agent = get(userPath(request.auth.uid)).data;
      return isAuthenticated()
        && agent.role == 'agente'
        && isValidQuotation(data)
        && data.id == quotationId
        && data.agentId == request.auth.uid
        && data.agentName == agent.name
        && requestAfter.userId == data.clientId
        && requestAfter.status == 'Cotizado'
        && requestAfter.quotationId == quotationId;
    }

    // Campos que un cliente puede tocar al responder (status,
    // respondedAtMillis, latestObservation, reservationId). El resto del
    // documento queda congelado por changed.hasOnly(...) y ya fue
    // validado al crearse, así que aquí NO se revalidan servicios ni
    // importes: eso agotaba el presupuesto de expresiones del lote de
    // aceptación (create reserva + update cotización + update solicitud).
    function isValidQuotationClientResponseFields(data) {
      return data.status in ['Cotizado', 'Aceptada', 'Observada', 'Cancelada']
        && (data.respondedAtMillis == null
          || (data.respondedAtMillis is int && data.respondedAtMillis > 0))
        && data.latestObservation is string
        && data.latestObservation.size() <= 500
        && data.reservationId is string
        && data.reservationId.size() <= 128;
    }

    function isValidClientQuotationUpdate(quotationId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let canRespond = resource.data.status in ['Cotizado', 'Observada'];
      let accepted = data.status == 'Aceptada'
        && (!('validUntilMillis' in resource.data)
          || request.time.toMillis() < resource.data.validUntilMillis)
        && data.reservationId == quotationId
        && existsAfter(reservationPath(quotationId))
        && getAfter(reservationPath(quotationId)).data.clientId == request.auth.uid
        && getAfter(reservationPath(quotationId)).data.quotationId == quotationId;
      let observed = data.status == 'Observada'
        && validString(data.latestObservation, 10, 500)
        && data.reservationId == resource.data.reservationId;
      let cancelled = data.status == 'Cancelada'
        && data.latestObservation == ''
        && data.reservationId == resource.data.reservationId;
      return isClient()
        && resource.data.clientId == request.auth.uid
        && isValidQuotationClientResponseFields(data)
        && canRespond
        && isRecentMillis(data.respondedAtMillis)
        && changed.hasOnly([
          'status', 'respondedAtMillis', 'latestObservation', 'reservationId'
        ])
        && (accepted || observed || cancelled);
    }

    function isValidAgentQuotationUpdate() {
      let data = request.resource.data;
      return isAgent()
        && resource.data.agentId == request.auth.uid
        && isValidQuotationUpdateFields(data)
        && resource.data.status == 'Observada'
        && data.status == 'Cotizado'
        && data.validUntilMillis is int
        && data.validUntilMillis > request.time.toMillis()
        && data.validUntilMillis <= request.time.toMillis() + 2678400000
        && data.diff(resource.data).affectedKeys().hasOnly([
          'services', 'baseCost', 'marginPercent', 'totalAmount',
          'validityDate', 'validUntilMillis', 'conditions', 'status',
          'version', 'parentQuotationId'
        ]);
    }

    function isValidAgentRequestQuotationUpdate(requestId) {
      let data = request.resource.data;
      let quotationAfter = getAfter(quotationPath(data.quotationId)).data;
      return resource.data.status == 'Pendiente de cotizacion'
        && data.status == 'Cotizado'
        && data.id == requestId
        && data.quotationId is string
        && data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'quotationId'])
        && quotationAfter.requestId == requestId
        && quotationAfter.clientId == resource.data.userId
        && quotationAfter.agentId == request.auth.uid
        && quotationAfter.status == 'Cotizado';
    }

    function isValidClientRequestResponseUpdate(requestId) {
      let data = request.resource.data;
      let quotationAfter = getAfter(quotationPath(data.quotationId)).data;
      return resource.data.userId == request.auth.uid
        && resource.data.status in ['Cotizado', 'Observada']
        && data.status in ['Aceptada', 'Observada', 'Cancelada']
        && data.id == requestId
        && data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && quotationAfter.id == data.quotationId
        && quotationAfter.requestId == requestId
        && quotationAfter.clientId == request.auth.uid
        && quotationAfter.status == data.status;
    }

    function isValidAssignedAgentRequestUpdate(requestId) {
      let data = request.resource.data;
      let quotationAfter = getAfter(quotationPath(data.quotationId)).data;
      return data.id == requestId
        && data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && quotationAfter.requestId == requestId
        && quotationAfter.agentId == request.auth.uid
        && quotationAfter.status == data.status;
    }

    // HU07: en una actualización solo el estado y el vínculo de pago
    // pueden cambiar; el resto del documento se protege con
    // areImmutableFieldsUnchanged, así que no hace falta revalidarlo
    // completo (el evaluador de reglas tiene un límite de expresiones).
    function isValidReservationStatusChange(data) {
      return data.status in ['Confirmada', 'Pago enviado', 'Pago rechazado', 'Pagado']
        && data.paymentId is string
        && data.paymentId.size() <= 128
        && (
          (data.status == 'Confirmada' && data.paymentId == '')
          || (data.status in ['Pago enviado', 'Pago rechazado']
            && data.paymentId == data.id)
          || (data.status == 'Pagado' && data.paymentId == data.id)
        );
    }

    // HU07: el cliente envía su comprobante; la reserva pasa a
    // 'Pago enviado' y el pago nace 'Pendiente' en la misma tanda.
    function isValidClientPaymentSubmit() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let reservationAfter = getAfter(reservationPath(data.id)).data;
      return isClient()
        && resource.data.clientId == request.auth.uid
        && resource.data.status in ['Confirmada', 'Pago rechazado']
        && data.status == 'Pago enviado'
        && changed.hasOnly(['status', 'paymentId'])
        && data.paymentId == data.id
        && reservationAfter.id == data.id
        && reservationAfter.clientId == request.auth.uid
        && reservationAfter.status == 'Pago enviado'
        && reservationAfter.paymentId == data.id;
    }

    // HU07: solo el agente asignado resuelve el pago pendiente.
    function isValidAgentPaymentReview(reservationStatus, paymentStatus) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let paymentAfter = getAfter(paymentPath(data.paymentId)).data;
      return isAgent()
        && resource.data.agentId == request.auth.uid
        && resource.data.status == 'Pago enviado'
        && data.status == reservationStatus
        && changed.hasOnly(['status'])
        && data.paymentId == data.id
        && paymentAfter.id == data.paymentId
        && paymentAfter.reservationId == data.id
        && paymentAfter.status == paymentStatus;
    }

    // ===============================================================
    // Collection rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAgent() || isManager();
      allow create: if isValidUserCreate(userId);
      allow update: if isValidUserUpdate(userId);
      allow delete: if false;

      match /user_preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /travel_requests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAgent() || isManager());

      allow create: if !exists(requestPath(requestId))
        && isClient()
        && isValidTravelRequest(request.resource.data)
        && request.resource.data.id == requestId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pendiente de cotizacion'
        && request.resource.data.destinationLatitude is number
        && request.resource.data.destinationLongitude is number
        // La app serializa quotationId vacío al crear; el agente lo llena
        // de verdad al cotizar (isValidAgentRequestQuotationUpdate).
        && (!('quotationId' in request.resource.data)
          || request.resource.data.quotationId == '')
        && isRecentMillis(request.resource.data.createdAtMillis);

      // El vínculo de la cotización prueba que el actor es el agente que fue
      // validado al crearla, evitando otra lectura de perfil en este batch.
      // Las demás transiciones mantienen su comprobación explícita de rol.
      allow update: if isValidAgentRequestQuotationUpdate(requestId)
        || (
          isClient()
          && isValidClientRequestResponseUpdate(requestId)
        ) || (
          isAgent()
          && isValidAssignedAgentRequestUpdate(requestId)
        );

      allow delete: if false;
    }

    match /catalog_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAgent()
        && isValidCatalogService(request.resource.data)
        && request.resource.data.id == serviceId;
      allow delete: if false;
    }

    // ===============================================================
    // HU catálogo turístico (proceso: destinos -> proveedores ->
    // paquetes -> publicación). Escritura exclusiva del administrador.
    // ===============================================================

    match /destinations/{destinationId} {
      // El cliente solo puede leer destinos publicados; el administrador
      // ve también borradores y archivados para gestionarlos.
      allow read: if isAuthenticated()
        && (isAdmin() || resource.data.status == 'PUBLICADO');

      allow create: if isAdmin()
        && isValidDestination(request.resource.data)
        && request.resource.data.id == destinationId
        && request.resource.data.createdBy == request.auth.uid
        // Un destino recién creado nace con su marca de tiempo inicial.
        && request.resource.data.createdAtMillis == request.resource.data.updatedAtMillis;

      // El administrador puede editar el destino y moverlo por su ciclo
      // de vida (BORRADOR -> PUBLICADO -> ARCHIVADO).
      allow update: if isAdmin()
        && isValidDestination(request.resource.data)
        && catalogIdentityPinned(destinationId);

      allow delete: if false;
    }

    match /providers/{providerId} {
      allow read: if isAuthenticated();

      allow create: if isAdmin()
        && isValidProvider(request.resource.data)
        && request.resource.data.id == providerId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAtMillis == request.resource.data.updatedAtMillis;

      allow update: if isAdmin()
        && isValidProvider(request.resource.data)
        && catalogIdentityPinned(providerId);

      allow delete: if false;
    }

    match /packages/{packageId} {
      allow read: if isAuthenticated()
        && (isAdmin() || resource.data.status == 'PUBLICADO');

      allow create: if isAdmin()
        && isValidPackage(request.resource.data)
        && request.resource.data.id == packageId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'BORRADOR'
        && request.resource.data.destinationId.size() > 0
        && exists(/databases/$(database)/documents/destinations/$(request.resource.data.destinationId))
        && request.resource.data.createdAtMillis == request.resource.data.updatedAtMillis;

      allow update: if isAdmin()
        && isValidPackage(request.resource.data)
        && catalogIdentityPinned(packageId)
        && exists(/databases/$(database)/documents/destinations/$(request.resource.data.destinationId))
        && (request.resource.data.status != 'PUBLICADO'
          || get(/databases/$(database)/documents/destinations/$(request.resource.data.destinationId)).data.status == 'PUBLICADO');

      allow delete: if false;

      match /included_services/{serviceId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /preferences/{preferenceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAgent()
        && isValidPreference(request.resource.data)
        && request.resource.data.id == preferenceId;
      allow delete: if false;
    }

    match /cotizaciones/{quotationId} {
      allow read: if isAuthenticated()
        && (resource.data.clientId == request.auth.uid
          || (isAgent() && resource.data.agentId == request.auth.uid)
          || isManager());

      // Firestore already distinguishes create from update, so an existence
      // lookup here is redundant and only consumes the batch budget.
      allow create: if isValidAgentQuotationCreate(quotationId);

      allow update: if isValidClientQuotationUpdate(quotationId)
        || isValidAgentQuotationUpdate();

      allow delete: if false;

      match /observations/{observationId} {
        allow read: if isAuthenticated()
          && exists(quotationPath(quotationId))
          && (
            get(quotationPath(quotationId)).data.clientId == request.auth.uid
            || (isAgent()
              && get(quotationPath(quotationId)).data.agentId == request.auth.uid)
          );

        allow create: if isClient()
          && isValidObservation(request.resource.data)
          && request.resource.data.id == observationId
          && request.resource.data.quotationId == quotationId
          && request.resource.data.authorId == request.auth.uid
          && existsAfter(quotationPath(quotationId))
          && getAfter(quotationPath(quotationId)).data.clientId == request.auth.uid
          && getAfter(quotationPath(quotationId)).data.status == 'Observada'
          && getAfter(quotationPath(quotationId)).data.latestObservation
            == request.resource.data.message
          && getAfter(quotationPath(quotationId)).data.respondedAtMillis
            == request.resource.data.createdAtMillis;

        allow update, delete: if false;
      }
    }

    // HU07/HU06: la reserva creada por el cliente debe reflejar exactamente
    // la cotización aceptada y los datos de la solicitud; ambos documentos
    // se escriben en la misma transacción y sus reglas garantizan su
    // integridad, por lo que aquí basta el cruce de campos. Se usa una
    // función (y no una cadena inline) para reutilizar los getAfter sin
    // repetirlos: el evaluador cobra cada expresión de un presupuesto
    // fijo de 1000 por escritura.
    // HU07/HU06: la reserva creada por el cliente debe reflejar la
    // cotización aceptada y la solicitud. Solo se cruzan los campos
    // críticos: el resto ya quedó inmutable en sus documentos de origen
    // (las reglas de cotizaciones y travel_requests congelan esos
    // campos), y el evaluador tiene un techo de 1000 expresiones por
    // lote que un cruce exhaustivo desbordaba.
    function isValidAcceptedReservation(reservationId) {
      let data = request.resource.data;
      let quotationAfter = getAfter(quotationPath(reservationId)).data;
      let requestAfter = getAfter(requestPath(data.requestId)).data;
      return existsAfter(quotationPath(reservationId))
        && quotationAfter.status == 'Aceptada'
        && quotationAfter.clientId == request.auth.uid
        && quotationAfter.reservationId == reservationId
        && quotationAfter.requestId == data.requestId
        && quotationAfter.agentId == data.agentId
        && quotationAfter.totalAmount == data.totalAmount
        && quotationAfter.currency == data.currency
        && requestAfter.originCity == data.originCity
        && requestAfter.departureAtMillis == data.departureAtMillis
        && requestAfter.returnAtMillis == data.returnAtMillis;
    }

    match /reservations/{reservationId} {
      allow read: if isAuthenticated()
        && (resource.data.clientId == request.auth.uid
          || (isAgent() && resource.data.agentId == request.auth.uid)
          || isManager());

      allow create: if !exists(reservationPath(reservationId))
        && isClient()
        && isValidReservation(request.resource.data)
        && request.resource.data.id == reservationId
        && request.resource.data.quotationId == reservationId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'Confirmada'
        && request.resource.data.paymentId == ''
        && request.resource.data.paymentVoucherUrl == ''
        && request.resource.data.paymentMethod == ''
        && request.resource.data.paidAtMillis == null
        && isRecentMillis(request.resource.data.createdAtMillis)
        && isValidAcceptedReservation(reservationId);

      allow update: if exists(reservationPath(reservationId))
        && isValidReservationStatusChange(request.resource.data)
        && areImmutableFieldsUnchanged([
          'id', 'quotationId', 'requestId', 'clientId', 'agentId',
          'destination', 'originCity', 'departureAtMillis',
          'returnAtMillis', 'travelerCount', 'services', 'totalAmount',
          'currency', 'validityDate', 'conditions', 'createdAtMillis',
          'paymentVoucherUrl', 'paymentMethod', 'paidAtMillis'
        ])
        && (
          isValidClientPaymentSubmit()
          || isValidAgentPaymentReview('Pagado', 'Aprobado')
          || isValidAgentPaymentReview('Pago rechazado', 'Rechazado')
        );

      allow delete: if false;

      match /{subcollection=**} {
        allow read, write: if false;
      }
    }

    // HU07: pago independiente de la reserva. El ID del pago es el ID de
    // la reserva, por lo que nunca pueden existir dos pagos por reserva.
    match /payments/{paymentId} {
      allow read: if isAuthenticated()
        && (resource.data.clientId == request.auth.uid
          || (isAgent() && resource.data.agentId == request.auth.uid)
          || isManager());

      // El cliente registra su comprobante junto con el cambio de la
      // reserva a 'Pago enviado' (la verificación de importe y moneda se
      // hace contra la reserva en la misma tanda).
      allow create: if !exists(paymentPath(paymentId))
        && isClient()
        && isValidPayment(request.resource.data)
        && request.resource.data.id == paymentId
        && request.resource.data.reservationId == paymentId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'Pendiente'
        && isRecentMillis(request.resource.data.submittedAtMillis)
        && existsAfter(reservationPath(paymentId))
        && getAfter(reservationPath(paymentId)).data.clientId
          == request.auth.uid
        && getAfter(reservationPath(paymentId)).data.status
          == 'Pago enviado'
        && getAfter(reservationPath(paymentId)).data.paymentId == paymentId
        && getAfter(reservationPath(paymentId)).data.totalAmount
          == request.resource.data.amount
        && getAfter(reservationPath(paymentId)).data.currency
          == request.resource.data.currency
        // El agente y la cotización del pago deben coincidir con la
        // reserva: nadie puede reasignar la revisión a otro agente.
        && getAfter(reservationPath(paymentId)).data.agentId
          == request.resource.data.agentId
        && getAfter(reservationPath(paymentId)).data.quotationId
          == request.resource.data.quotationId;

      allow update: if exists(paymentPath(paymentId)) && (
        // El cliente reenvía un comprobante tras un rechazo.
        isClient()
        && resource.data.clientId == request.auth.uid
        && resource.data.status == 'Rechazado'
        && request.resource.data.status == 'Pendiente'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'method', 'amount', 'currency', 'voucherUrl', 'status',
            'rejectionReason', 'submittedAtMillis', 'reviewedAtMillis',
            'reviewedBy'
          ])
        && isRecentMillis(request.resource.data.submittedAtMillis)
        && existsAfter(reservationPath(paymentId))
        && getAfter(reservationPath(paymentId)).data.status
          == 'Pago enviado'
        && getAfter(reservationPath(paymentId)).data.paymentId == paymentId
        && getAfter(reservationPath(paymentId)).data.totalAmount
          == request.resource.data.amount
        && getAfter(reservationPath(paymentId)).data.currency
          == request.resource.data.currency
        // El agente y la cotización del pago deben coincidir con la
        // reserva: nadie puede reasignar la revisión a otro agente.
        && getAfter(reservationPath(paymentId)).data.agentId
          == request.resource.data.agentId
        && getAfter(reservationPath(paymentId)).data.quotationId
          == request.resource.data.quotationId
      ) || (
        // El agente asignado aprueba o rechaza el pago pendiente.
        isAgent()
        && resource.data.agentId == request.auth.uid
        && resource.data.status == 'Pendiente'
        && request.resource.data.status in ['Aprobado', 'Rechazado']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'rejectionReason', 'reviewedAtMillis', 'reviewedBy'
          ])
        && isRecentMillis(request.resource.data.reviewedAtMillis)
        && request.resource.data.reviewedBy == request.auth.uid
        && (request.resource.data.status == 'Aprobado'
          ? getAfter(reservationPath(paymentId)).data.status == 'Pagado'
          : getAfter(reservationPath(paymentId)).data.status
            == 'Pago rechazado')
        && getAfter(reservationPath(paymentId)).data.paymentId == paymentId
      )
        && isValidPayment(request.resource.data);

      allow delete: if false;

      match /{subcollection=**} {
        allow read, write: if false;
      }
    }

    // Centro de viaje: el itinerario oficial pertenece a una reserva
    // pagada y solo puede ser gestionado por el agente asignado.
    match /trip_itinerary_items/{itemId} {
      allow read: if isAuthenticated()
        && (
          resource.data.clientId == request.auth.uid
          || (isAgent() && resource.data.agentId == request.auth.uid)
        );

      allow create: if isAgent()
        && isValidTripItineraryItem(request.resource.data)
        && request.resource.data.id == itemId
        && request.resource.data.agentId == request.auth.uid
        && paidReservationAssignedToAgent(
          request.resource.data.reservationId,
          request.auth.uid
        )
        && get(reservationPath(request.resource.data.reservationId)).data.clientId
          == request.resource.data.clientId;

      allow update: if isAgent()
        && resource.data.agentId == request.auth.uid
        && isValidTripItineraryItem(request.resource.data)
        && request.resource.data.id == itemId
        && areImmutableFieldsUnchanged([
          'id', 'reservationId', 'clientId', 'agentId', 'source',
          'createdAtMillis'
        ])
        && paidReservationAssignedToAgent(
          resource.data.reservationId,
          request.auth.uid
        );

      allow delete: if isAgent()
        && resource.data.agentId == request.auth.uid
        && paidReservationAssignedToAgent(
          resource.data.reservationId,
          request.auth.uid
        );
    }

    // El checklist es privado del viajero. El agente no necesita leerlo
    // para programar el itinerario ni para atender una incidencia.
    match /trip_checklist_items/{itemId} {
      allow read: if isAuthenticated()
        && resource.data.clientId == request.auth.uid;

      allow create: if isClient()
        && isValidTripChecklistItem(request.resource.data)
        && request.resource.data.id == itemId
        && request.resource.data.clientId == request.auth.uid
        && paidReservationBelongsToClient(
          request.resource.data.reservationId,
          request.auth.uid
        );

      allow update: if isClient()
        && resource.data.clientId == request.auth.uid
        && isValidTripChecklistItem(request.resource.data)
        && request.resource.data.id == itemId
        && areImmutableFieldsUnchanged([
          'id', 'reservationId', 'clientId', 'createdAtMillis'
        ])
        && paidReservationBelongsToClient(
          resource.data.reservationId,
          request.auth.uid
        );

      allow delete: if isClient()
        && resource.data.clientId == request.auth.uid
        && paidReservationBelongsToClient(
          resource.data.reservationId,
          request.auth.uid
        );
    }

    // El cliente abre una incidencia. El agente asignado solo puede
    // responder y avanzar su estado, sin alterar autoría ni descripción.
    match /trip_incidents/{incidentId} {
      allow read: if isAuthenticated()
        && (
          resource.data.clientId == request.auth.uid
          || (isAgent() && resource.data.agentId == request.auth.uid)
        );

      allow create: if isClient()
        && isValidTripIncident(request.resource.data)
        && request.resource.data.id == incidentId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'Abierta'
        && request.resource.data.agentResponse == ''
        && request.resource.data.resolvedAtMillis == null
        && paidReservationBelongsToClient(
          request.resource.data.reservationId,
          request.auth.uid
        )
        && get(reservationPath(request.resource.data.reservationId)).data.agentId
          == request.resource.data.agentId;

      allow update: if isAgent()
        && resource.data.agentId == request.auth.uid
        && isValidTripIncident(request.resource.data)
        && request.resource.data.id == incidentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'agentResponse', 'status', 'updatedAtMillis', 'resolvedAtMillis'
        ])
        && validString(request.resource.data.agentResponse, 5, 1000)
        && (
          (resource.data.status == 'Abierta'
            && request.resource.data.status in ['En revisión', 'Resuelta'])
          || (resource.data.status == 'En revisión'
            && request.resource.data.status in ['En revisión', 'Resuelta'])
          || (resource.data.status == 'Resuelta'
            && request.resource.data.status == 'Resuelta')
        )
        && (request.resource.data.status == 'Resuelta'
          ? request.resource.data.resolvedAtMillis is int
          : request.resource.data.resolvedAtMillis == null)
        && areImmutableFieldsUnchanged([
          'id', 'reservationId', 'clientId', 'agentId', 'category',
          'priority', 'description', 'locationName', 'latitude',
          'longitude', 'createdAtMillis'
        ])
        && paidReservationAssignedToAgent(
          resource.data.reservationId,
          request.auth.uid
        );

      allow delete: if false;
    }

    // Default deny for every path not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

